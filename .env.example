# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clé secrète (serveur uniquement, ne jamais exposer)
SUPABASE_SECRET_KEY=sb_secret_...

# Connexion Google / Apple : mettre "on" une fois le fournisseur activé dans Supabase
NEXT_PUBLIC_AUTH_GOOGLE=off
NEXT_PUBLIC_AUTH_APPLE=off

# Adresse publique de l'application
APP_URL=https://moien100.lu

# Rappels par e-mail (resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM="Lëtzebuergesch en 100 jours <rappel@moien100.lu>"

# Secret partagé avec Vercel Cron (une longue chaîne aléatoire)
CRON_SECRET=
